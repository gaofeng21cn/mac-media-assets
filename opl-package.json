{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "mac-media-assets",
    "version": "0.2.15",
    "intent": "extension",
    "name": {
      "zh-CN": "Med Auto Cast Assets",
      "en-US": "Med Auto Cast Assets"
    },
    "summary": {
      "zh-CN": "可复用的医学科普动画素材、纸剧场组件与声音资源库。",
      "en-US": "Reusable medical education animation assets, paper-theatre components, and sound resources."
    },
    "description": {
      "zh-CN": "默认安装轻量索引与代码组件，按需获取素材；可在软件中心选择离线完整版。",
      "en-US": "Install a small catalog and code components by default; fetch media as needed or choose the complete offline installation."
    },
    "publisher": "one-person-lab",
    "license": "Apache-2.0",
    "icon": "assets/branding/mac-media-assets-logo.png",
    "repository": "https://github.com/gaofeng21cn/mac-media-assets",
    "routing_summary": {
      "zh-CN": "默认安装轻量索引与代码组件，按需获取素材；可在软件中心选择离线完整版。",
      "en-US": "Install a small catalog and code components by default; fetch media as needed or choose the complete offline installation."
    }
  },
  "permissions": {
    "workspace": {
      "access": "read"
    },
    "execution_mode": "local_subprocess"
  },
  "provides": {
    "module_ids": [
      "mac-media-assets.discovery",
      "mac-media-assets.media"
    ],
    "skills": [
      {
        "id": "mac-media-assets",
        "path": "skills/mac-media-assets",
        "exposure": "opt_in"
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "python3",
        "tools/query_assets.py",
        "--app-review"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "mac-media-assets.review",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "素材审看范围",
            "en-US": "Asset review scope"
          },
          "data_ref": "mac.media.v1#review",
          "empty_state": {
            "zh-CN": "选择一个素材记录后查看审看范围",
            "en-US": "Select an asset record to inspect its review scope"
          },
          "sort_order": 800
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/mac-media-assets",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": true,
      "plugin_name": "mac-media-assets",
      "category": "Productivity",
      "capabilities": [
        "Skill",
        "CLI"
      ]
    }
  }
}
