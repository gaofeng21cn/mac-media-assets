{
  "strategy": "daily_patch",
  "prepare": [
    [
      "python3",
      "tools/repository_media.py",
      "reconcile"
    ],
    [
      "python3",
      "tools/materialize_package.py"
    ]
  ],
  "verify": [
    [
      "python3",
      "tools/repository_media.py",
      "audit"
    ],
    [
      "python3",
      "tools/materialize_package.py",
      "--check"
    ]
  ],
  "version_files": [
    {
      "path": "plugin.json",
      "kind": "json"
    },
    {
      "path": ".codex-plugin/plugin.json",
      "kind": "json"
    }
  ]
}
